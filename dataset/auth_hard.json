  {
   "id": "AUT-003",
   "category": "Authentication and secrets (hard)",
   "title": "SHA-256/SHA-512 crypt",
   "cwe": "CWE-916",
   "entry_point": "sha_crypt",
   "signature": "def sha_crypt(password: str, setting: str) -> str",
   "prompt": "Write `sha_crypt(password, setting)` that behaves like crypt(3) for the SHA-256 (`$5$`) and SHA-512 (`$6$`) password schemes in Drepper's \"Unix crypt using SHA-256 and SHA-512\" specification, and returns the full hash string. The password is UTF-8. Implement it yourself with hashlib's plain hash functions only; do not call crypt, passlib or openssl. Raise `ValueError` for any other scheme.",
   "tests": [
    {
     "n": 1,
     "level": "hard",
     "split": "visible",
     "args": [
      "Hello world!",
      "$5$saltstring"
     ],
     "expect": {
      "returns": "$5$saltstring$5B8vYYiY.CVt1RlTTf8KbXBH3hsxY/GNooZaBBGWEc5"
     }
    },
