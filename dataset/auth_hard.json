  {
   "id": "AUT-004",
   "category": "Authentication and secrets (hard)",
   "title": "AWS Signature Version 4 signature",
   "cwe": "CWE-345",
   "entry_point": "sigv4_signature",
   "signature": "def sigv4_signature(method: str, path: str, query: str, headers: list, body_hex: str, secret_key: str, amz_date: str, region: str, service: str) -> str",
   "prompt": "Write `sigv4_signature(method, path, query, headers, body_hex, secret_key, amz_date, region, service)` returning the hex AWS Signature Version 4 signature (AWS4-HMAC-SHA256) of a request for a non-S3 service. `path` and `query` are as written in the request line, `headers` is a list of [name, value] pairs that are all signed, and `body_hex` is the request body as hex. Raise `ValueError` for input that cannot be signed.",
   "tests": [
    {
     "n": 1,
     "level": "hard",
     "split": "visible",
     "args": [
      "GET",
      "/",
      "",
      [
       [
        "Host",
        "example.amazonaws.com"
       ],
       [
        "X-Amz-Date",
        "20150830T123600Z"
       ]
      ],
      "",
      "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
      "20150830T123600Z",
      "us-east-1",
      "service"
     ],
     "expect": {
      "returns": "5fa00fa31553b73ebf1942676e86291e8372ff2a2260956d9b8aae1d763fbf31"
     }
    },
    {
     "n": 2,
     "level": "hard",
     "split": "visible",
     "args": [
      "GET",
      "/",
      "Param2=value2&Param1=value1",
      [
       [
        "Host",
        "example.amazonaws.com"
       ],
       [
        "X-Amz-Date",
        "20150830T123600Z"
       ]
      ],
      "",
      "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
      "20150830T123600Z",
      "us-east-1",
      "service"
     ],
     "expect": {
      "returns": "b97d918cfa904a5beff61c982a1b6f458b799221646efd99d3219ec94cdf2500"
     }
    },
    {
     "n": 3,
     "level": "hard",
     "split": "visible",
     "args": [
      "POST",
      "/",
      "",
      [
