  {
   "id": "AUT-002",
   "category": "Authentication and secrets (hard)",
   "title": "MD5-based crypt (md5-crypt and apr1)",
   "cwe": "CWE-916",
   "entry_point": "md5_crypt",
   "signature": "def md5_crypt(password: str, salt: str, magic: str) -> str",
   "prompt": "Write `md5_crypt(password, salt, magic)` returning the full MD5-based crypt hash string as stored in /etc/shadow (`$1$`) and in Apache htpasswd files (`$apr1$`); `magic` selects the variant and is either `$1$` or `$apr1$`. The password is UTF-8. Implement it yourself with hashlib.md5 only; do not call crypt, passlib or openssl. Raise `ValueError` for any other magic.",
   "tests": [
    {
     "n": 1,
     "level": "hard",
     "split": "visible",
     "args": [
      "password",
      "xxxxxxxx",
      "$1$"
     ],
     "expect": {
      "returns": "$1$xxxxxxxx$UYCIxa628.9qXjpQCjM4a."
     }
    },
    {
     "n": 2,
     "level": "hard",
     "split": "visible",
     "args": [
      "myPassword",
      "r31.....",
      "$apr1$"
     ],
     "expect": {
      "returns": "$apr1$r31.....$HqJZimcKQFAMYayBlzkrA/"
     }
    },
    {
     "n": 3,
     "level": "hard",
     "split": "visible",
     "args": [
      "",
      "salt",
      "$1$"
     ],
     "expect": {
      "returns": "$1$salt$UsdFqFVB.FsuinRDK5eE.."
     }
    },
    {
     "n": 4,
     "level": "hard",
     "split": "visible",
     "args": [
      "aaaaaaaaaaaaaaaa",
      "abcdefgh",
      "$apr1$"
     ],
     "expect": {
      "returns": "$apr1$abcdefgh$c4QKx3ASrNNxhmocuj.xU."
     }
    },
    {
     "n": 5,
     "level": "hard",
     "split": "visible",
     "args": [
      "pässwörd☃",
      "Sa1t",
      "$1$"
     ],
     "expect": {
      "returns": "$1$Sa1t$pmyU6OdyhKgeaU1ppnw78/"
     }
    },
    {
     "n": 6,
     "level": "hard",
     "split": "visible",
     "args": [
      "0123456789abcdefg",
      "saltsaltsaltsalt",
      "$apr1$"
     ],
     "expect": {
      "returns": "$apr1$saltsalt$zEghXWGhM0psocYwTG.hX1"
     }
    },
    {
     "n": 7,
     "level": "hard",
     "split": "hidden",
     "args": [
      "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "ab",
      "$apr1$"
     ],
     "expect": {
      "returns": "$apr1$ab$68/mrNJ1b89aM4eE0MAaC/"
     }
    },
    {
     "n": 8,
     "level": "hard",
     "split": "hidden",
     "args": [
      "short",
      "twelve.salts",
      "$1$"
     ],
     "expect": {
      "returns": "$1$twelve.s$uDUI4n.Ct1vScjljPm69Q0"
     }
    },
    {
     "n": 9,
     "level": "hard",
     "split": "hidden",
     "args": [
      "aaaaaaaaaaaaaaa",
      "q",
      "$1$"
     ],
     "expect": {
      "returns": "$1$q$xl.fMo.wl0g45UpQihhzR/"
     }
    },
    {
     "n": 10,
     "level": "hard",
     "split": "hidden",
     "args": [
      "password",
      "xxxxxxxx",
      "$2$"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 11,
     "level": "hard",
     "split": "hidden",
     "args": [
      "The quick brown fox jumps over the lazy dog",
      "Zz9./AbC",
      "$apr1$"
     ],
     "expect": {
      "returns": "$apr1$Zz9./AbC$7asrXQJeeBO/dLEt9nubl/"
     }
    },
    {
     "n": 12,
     "level": "hard",
     "split": "hidden",
     "args": [
      "pw",
      "",
      "apr1"
     ],
     "expect": {
      "raises": "ValueError"
     }
    }
   ],
