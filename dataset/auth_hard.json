     }
    },
    {
     "n": 3,
     "level": "hard",
     "split": "visible",
     "args": [
      "Hello world!",
      "$5$rounds=10000$saltstringsaltstring"
     ],
     "expect": {
      "returns": "$5$rounds=10000$saltstringsaltst$3xv.VbSHBb41AL9AvLeujZkZRBAwqFMz2.opqey6IcA"
     }
    },
    {
     "n": 4,
     "level": "hard",
     "split": "visible",
     "args": [
      "Hello world!",
      "$6$rounds=10000$saltstringsaltstring"
     ],
     "expect": {
      "returns": "$6$rounds=10000$saltstringsaltst$OW1/O6BYHV6BcXZu8QVeXbDWra3Oeqh0sbHbbMCVNSnCM/UrjmM0Dp8vOuZeHBy/YTBmSK6H9qs/y3RnOaw5v."
     }
    },
    {
     "n": 5,
     "level": "hard",
     "split": "visible",
     "args": [
      "This is just a test",
      "$5$rounds=77777$toolongsaltstring"
     ],
     "expect": {
