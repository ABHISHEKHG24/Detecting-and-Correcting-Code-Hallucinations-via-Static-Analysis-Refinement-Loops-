     }
    },
    {
     "n": 12,
     "level": "hard",
     "split": "hidden",
     "args": [
      "üüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüüü"
     ],
     "expect": {
      "returns": "tdaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
     }
    }
   ],
   "forbid": {
    "imports": [
