  {
   "id": "VAL-007",
   "category": "Input validation / sanitization (hard)",
   "title": "Punycode decoder (RFC 3492)",
   "cwe": "CWE-20",
   "entry_point": "punycode_decode",
   "signature": "def punycode_decode(text: str) -> str",
   "prompt": "Write `punycode_decode(text)` that decodes Punycode text (RFC 3492, without the `xn--` prefix) back to a Unicode string. Digits may be upper or lower case. Raise `ValueError` for any invalid input: a non-ASCII character, a character that is not a Punycode digit, truncated data, or a result beyond U+10FFFF. Implement the Bootstring algorithm yourself: do not use the `punycode` or `idna` codecs or modules.",
   "tests": [
    {
     "n": 1,
     "level": "easy",
     "split": "visible",
     "args": [
      "bcher-kva"
     ],
     "expect": {
      "returns": "bücher"
     }
    },
