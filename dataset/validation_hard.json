  {
   "id": "VAL-006",
   "category": "Input validation / sanitization (hard)",
   "title": "Punycode encoder (RFC 3492)",
   "cwe": "CWE-20",
   "entry_point": "punycode_encode",
   "signature": "def punycode_encode(label: str) -> str",
   "prompt": "Write `punycode_encode(label)` that encodes a Unicode string with Punycode as defined in RFC 3492 and returns the ASCII result without the `xn--` prefix (for an all-ASCII input the result is the input followed by `-`). Implement the Bootstring algorithm yourself: do not use the `punycode` or `idna` codecs or modules.",
   "tests": [
    {
     "n": 1,
     "level": "easy",
     "split": "visible",
     "args": [
      "bücher"
     ],
     "expect": {
      "returns": "bcher-kva"
     }
    },
    {
     "n": 2,
     "level": "medium",
     "split": "visible",
     "args": [
      "a"
     ],
     "expect": {
      "returns": "a-"
     }
    },
    {
     "n": 3,
     "level": "hard",
     "split": "visible",
     "args": [
      "例え"
     ],
     "expect": {
      "returns": "r8jz45g"
     }
    },
    {
     "n": 4,
     "level": "easy",
     "split": "visible",
     "args": [
      ""
     ],
     "expect": {
      "returns": ""
     }
    },
    {
     "n": 5,
     "level": "medium",
     "split": "visible",
     "args": [
      "münchen"
     ],
     "expect": {
      "returns": "mnchen-3ya"
     }
    },
    {
     "n": 6,
     "level": "hard",
     "split": "visible",
     "args": [
      "ドメイン名例"
     ],
     "expect": {
      "returns": "eckwd4c7cu47r2wf"
     }
    },
    {
     "n": 7,
     "level": "easy",
     "split": "hidden",
     "args": [
      "☃"
     ],
     "expect": {
      "returns": "n3h"
     }
    },
    {
     "n": 8,
     "level": "medium",
     "split": "hidden",
     "args": [
      "abc"
     ],
     "expect": {
      "returns": "abc-"
     }
    },
    {
     "n": 9,
     "level": "hard",
     "split": "hidden",
     "args": [
      "😀x😀"
     ],
     "expect": {
      "returns": "x-iv3sba"
     }
    },
    {
     "n": 10,
     "level": "easy",
     "split": "hidden",
     "args": [
      "-é-"
     ],
     "expect": {
      "returns": "---bja"
     }
    },
    {
     "n": 11,
     "level": "medium",
     "split": "hidden",
     "args": [
      "مثال.إختبار"
     ],
     "expect": {
