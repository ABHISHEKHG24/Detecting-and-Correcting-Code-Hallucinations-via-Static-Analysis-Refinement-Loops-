{
 "dataset": "SAFE-Loop Input validation / sanitization set (hard) v0.1",
 "category": "Input validation / sanitization (hard)",
 "task_count": 8,
 "test_layout": "12 tests per task in order easy,medium,hard repeated 4 times; tests 1-6 = visible pool, tests 7-12 = hidden set",
 "test_format": {
  "args": "positional arguments",
  "expect": "{'returns': value} | {'raises': 'ValueError'}"
 },
 "notes": "Prompts name the standard; they do not list its rules. Tasks with a 'forbid' field must not import the listed modules or use the listed names/strings (runner.py checks this). Needs the latest runner.py.",
 "tasks": [
  {
   "id": "VAL-001",
   "category": "Input validation / sanitization (hard)",
   "title": "Resolve a relative URI (RFC 3986 section 5)",
   "cwe": "CWE-20",
   "entry_point": "resolve_uri",
   "signature": "def resolve_uri(base: str, ref: str) -> str",
   "prompt": "Write `resolve_uri(base, ref)` that resolves the URI reference `ref` against the absolute URI `base` exactly as RFC 3986 section 5 specifies (strict parser, no backward-compatibility exceptions), and returns the resulting URI. Raise `ValueError` if `base` has no scheme. Do not import urllib.",
   "tests": [
    {
     "n": 1,
     "level": "easy",
     "split": "visible",
     "args": [
      "http://a/b/c/d;p?q",
      "g"
     ],
     "expect": {
      "returns": "http://a/b/c/g"
     }
    },
    {
     "n": 2,
     "level": "medium",
     "split": "visible",
     "args": [
      "http://a/b/c/d;p?q",
      "../../../g"
     ],
     "expect": {
      "returns": "http://a/g"
     }
    },
    {
     "n": 3,
     "level": "hard",
     "split": "visible",
     "args": [
      "http://a/b/c/d;p?q",
      "g;x=1/../y"
     ],
     "expect": {
      "returns": "http://a/b/c/y"
     }
    },
    {
     "n": 4,
     "level": "easy",
     "split": "visible",
     "args": [
      "http://a/b/c/d;p?q",
      "g?y/./x"
     ],
     "expect": {
      "returns": "http://a/b/c/g?y/./x"
     }
    },
    {
     "n": 5,
     "level": "medium",
     "split": "visible",
     "args": [
      "http://a/b/c/d;p?q",
      "http:g"
     ],
     "expect": {
      "returns": "http:g"
     }
    },
    {
     "n": 6,
     "level": "hard",
     "split": "visible",
     "args": [
      "http://a/b/c/d;p?q",
      ""
     ],
     "expect": {
      "returns": "http://a/b/c/d;p?q"
     }
    },
    {
     "n": 7,
     "level": "easy",
     "split": "hidden",
     "args": [
      "http://a/b/c/d;p?q",
      "#s"
     ],
     "expect": {
      "returns": "http://a/b/c/d;p?q#s"
     }
    },
    {
     "n": 8,
     "level": "medium",
     "split": "hidden",
     "args": [
      "a/b/c",
      "g"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 9,
     "level": "hard",
     "split": "hidden",
     "args": [
      "http://a/b/c/d;p?q",
      "../.."
     ],
     "expect": {
      "returns": "http://a/"
     }
    },
    {
     "n": 10,
     "level": "easy",
     "split": "hidden",
     "args": [
      "http://a/b/c/d;p?q",
      "//g"
     ],
     "expect": {
      "returns": "http://g"
     }
    },
    {
     "n": 11,
     "level": "medium",
     "split": "hidden",
     "args": [
      "http://a/b/c/d;p?q",
      "./g/."
     ],
     "expect": {
      "returns": "http://a/b/c/g/"
     }
    },
    {
     "n": 12,
     "level": "hard",
     "split": "hidden",
     "args": [
      "http://a",
      "g"
     ],
     "expect": {
      "returns": "http://a/g"
     }
    }
   ],
   "forbid": {
    "imports": [
     "urllib",
     "urlparse",
     "yarl",
     "furl",
     "hyperlink"
    ],
    "names": []
   }
  },
  {
   "id": "VAL-002",
   "category": "Input validation / sanitization (hard)",
   "title": "Strict IPv4 address",
   "cwe": "CWE-20",
   "entry_point": "parse_ipv4",
   "signature": "def parse_ipv4(text: str) -> str",
   "prompt": "Write `parse_ipv4(text)` that parses an IPv4 address written as four decimal numbers separated by dots, using the `IPv4address` rule of RFC 3986 (the `dec-octet` grammar), and returns the 4 bytes as lower-case hex. Raise `ValueError` for anything that does not match that grammar exactly. Do not import ipaddress or socket.",
   "tests": [
    {
     "n": 1,
     "level": "easy",
     "split": "visible",
     "args": [
      "192.168.0.1"
     ],
     "expect": {
      "returns": "c0a80001"
     }
    },
    {
     "n": 2,
     "level": "medium",
     "split": "visible",
     "args": [
      "255.255.255.255"
     ],
     "expect": {
      "returns": "ffffffff"
     }
    },
    {
     "n": 3,
     "level": "hard",
     "split": "visible",
     "args": [
      "256.0.0.1"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 4,
     "level": "easy",
     "split": "visible",
     "args": [
      "0.0.0.0"
     ],
     "expect": {
      "returns": "00000000"
     }
    },
    {
     "n": 5,
     "level": "medium",
     "split": "visible",
     "args": [
      "01.2.3.4"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 6,
     "level": "hard",
     "split": "visible",
     "args": [
      "127.1"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 7,
     "level": "easy",
     "split": "hidden",
     "args": [
      "1.2.3.4\n"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 8,
     "level": "medium",
     "split": "hidden",
     "args": [
      "0x7f.0.0.1"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 9,
     "level": "hard",
     "split": "hidden",
     "args": [
      "1.2.3.04"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 10,
     "level": "easy",
     "split": "hidden",
     "args": [
      "٣.٣.٣.٣"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 11,
     "level": "medium",
     "split": "hidden",
     "args": [
      " 1.2.3.4"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 12,
     "level": "hard",
     "split": "hidden",
     "args": [
      "1.2.3.4.5"
     ],
     "expect": {
      "raises": "ValueError"
     }
    }
   ],
   "forbid": {
    "imports": [
     "ipaddress",
     "socket",
     "netaddr"
    ],
    "names": []
   }
  },
  {
   "id": "VAL-003",
   "category": "Input validation / sanitization (hard)",
   "title": "Strict IPv6 address",
   "cwe": "CWE-20",
   "entry_point": "parse_ipv6",
   "signature": "def parse_ipv6(text: str) -> str",
   "prompt": "Write `parse_ipv6(text)` that parses an IPv6 address in the text forms of RFC 4291 section 2.2 (full, with `::` compression, and with a trailing dotted IPv4 part) and returns the 16 bytes as lower-case hex. Hex digits may be in either case. Raise `ValueError` for anything else, including zone identifiers such as `%eth0`, prefix lengths, and any IPv4 part that is not a strict RFC 3986 `IPv4address`. Do not import ipaddress or socket.",
   "tests": [
    {
     "n": 1,
     "level": "easy",
     "split": "visible",
     "args": [
      "::"
     ],
     "expect": {
      "returns": "00000000000000000000000000000000"
     }
    },
    {
     "n": 2,
     "level": "medium",
     "split": "visible",
     "args": [
      "2001:db8::ff00:42:8329"
     ],
     "expect": {
      "returns": "20010db8000000000000ff0000428329"
     }
    },
    {
     "n": 3,
     "level": "hard",
     "split": "visible",
     "args": [
      "::ffff:192.0.2.128"
     ],
     "expect": {
      "returns": "00000000000000000000ffffc0000280"
     }
    },
    {
     "n": 4,
     "level": "easy",
     "split": "visible",
     "args": [
      "1:2:3:4:5:6:7:8"
     ],
     "expect": {
      "returns": "00010002000300040005000600070008"
     }
    },
    {
     "n": 5,
     "level": "medium",
     "split": "visible",
     "args": [
      "1::2::3"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 6,
     "level": "hard",
     "split": "visible",
     "args": [
      "fe80::1%eth0"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 7,
     "level": "easy",
     "split": "hidden",
     "args": [
      "12345::"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 8,
     "level": "medium",
     "split": "hidden",
     "args": [
      "1:2:3:4:5:6:7"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 9,
     "level": "hard",
     "split": "hidden",
     "args": [
      "::1.2.3"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 10,
     "level": "easy",
     "split": "hidden",
     "args": [
      "::01.2.3.4"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 11,
     "level": "medium",
     "split": "hidden",
     "args": [
      "1:2:3:4:5:6:1.2.3.4"
     ],
     "expect": {
      "returns": "00010002000300040005000601020304"
     }
    },
    {
     "n": 12,
     "level": "hard",
     "split": "hidden",
     "args": [
      "2001:DB8:0:0:0:0:0:1"
     ],
     "expect": {
      "returns": "20010db8000000000000000000000001"
     }
    }
   ],
   "forbid": {
    "imports": [
     "ipaddress",
     "socket",
     "netaddr"
    ],
    "names": []
   }
  },
  {
   "id": "VAL-004",
   "category": "Input validation / sanitization (hard)",
   "title": "Is this IP address inside this CIDR block?",
   "cwe": "CWE-20",
   "entry_point": "ip_in_cidr",
   "signature": "def ip_in_cidr(ip: str, cidr: str) -> bool",
   "prompt": "Write `ip_in_cidr(ip, cidr)` that returns True if the IPv4 or IPv6 address `ip` lies inside the network `cidr` written as `address/prefix-length`. Both parts must be strictly valid (the prefix is decimal digits only, no leading zeros, within the address size, and the network address must have no host bits set), otherwise raise `ValueError`. An IPv4 address is never inside an IPv6 network or the other way round (return False, including IPv4-mapped IPv6 forms). Do not import ipaddress or socket.",
   "tests": [
    {
     "n": 1,
     "level": "easy",
     "split": "visible",
     "args": [
      "10.1.2.3",
      "10.0.0.0/8"
     ],
     "expect": {
      "returns": true
     }
    },
    {
     "n": 2,
     "level": "medium",
     "split": "visible",
     "args": [
      "192.168.2.5",
      "192.168.1.0/24"
     ],
     "expect": {
      "returns": false
     }
    },
    {
     "n": 3,
     "level": "hard",
     "split": "visible",
     "args": [
      "::ffff:10.0.0.1",
      "10.0.0.0/8"
     ],
     "expect": {
      "returns": false
     }
    },
    {
     "n": 4,
     "level": "easy",
     "split": "visible",
     "args": [
      "10.0.0.1",
      "10.0.0.1/0"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 5,
     "level": "medium",
     "split": "visible",
     "args": [
      "2001:db8::1",
      "2001:db8::/32"
     ],
     "expect": {
      "returns": true
     }
    },
    {
     "n": 6,
     "level": "hard",
     "split": "visible",
     "args": [
      "1.2.3.4",
      "0.0.0.0/0"
     ],
     "expect": {
      "returns": true
     }
    },
    {
     "n": 7,
     "level": "easy",
     "split": "hidden",
     "args": [
      "10.0.0.0",
      "10.0.0.0/33"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 8,
     "level": "medium",
     "split": "hidden",
     "args": [
      "10.0.0.0",
      "10.0.0.0/08"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 9,
     "level": "hard",
     "split": "hidden",
     "args": [
      "10.0.0.0",
      "10.0.0.0/255.0.0.0"
     ],
     "expect": {
      "raises": "ValueError"
     }
    },
    {
     "n": 10,
     "level": "easy",
     "split": "hidden",
     "args": [
      "::1",
      "::1/128"
     ],
     "expect": {
      "returns": true
     }
    },
    {
     "n": 11,
     "level": "medium",
     "split": "hidden",
     "args": [
      "1.2.3.4",
      "1.2.3.4/32"
     ],
     "expect": {
      "returns": true
     }
    },
    {
     "n": 12,
     "level": "hard",
     "split": "hidden",
     "args": [
      "2001:db8:1::1",
      "2001:db8::/33"
     ],
     "expect": {
      "returns": true
     }
    }
   ],
   "forbid": {
    "imports": [
     "ipaddress",
     "socket",
     "netaddr"
    ],
    "names": []
   }
  },
