   "category": "Input validation / sanitization (hard)",
   "title": "UUID version and variant",
   "cwe": "CWE-20",
   "entry_point": "uuid_info",
   "signature": "def uuid_info(text: str) -> list",
   "prompt": "Write `uuid_info(text)` that returns `[version, variant]` for a UUID written in the canonical 8-4-4-4-12 hyphenated form (hex digits in either case): the version is the 4-bit version field (0 to 15) and the variant is one of `\"ncs\"`, `\"rfc4122\"`, `\"microsoft\"`, `\"reserved\"` as defined in RFC 9562 section 4.1. Raise `ValueError` for any other spelling (braces, `urn:uuid:`, missing hyphens, extra whitespace). Do not import uuid.",
   "tests": [
    {
     "n": 1,
     "level": "easy",
     "split": "visible",
     "args": [
      "017f22e2-79b0-7cc3-98c4-dc0c0c07398f"
     ],
     "expect": {
      "returns": [
       7,
       "rfc4122"
      ]
     }
    },
    {
     "n": 2,
     "level": "medium",
     "split": "visible",
     "args": [
      "00000000-0000-0000-0000-000000000000"
     ],
     "expect": {
      "returns": [
       0,
       "ncs"
      ]
     }
    },
    {
     "n": 3,
     "level": "hard",
     "split": "visible",
     "args": [
      "ffffffff-ffff-ffff-ffff-ffffffffffff"
     ],
     "expect": {
      "returns": [
       15,
       "reserved"
      ]
     }
    },
    {
     "n": 4,
     "level": "easy",
     "split": "visible",
     "args": [
      "{017f22e2-79b0-7cc3-98c4-dc0c0c07398f}"
     ],
